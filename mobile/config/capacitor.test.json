{
  "appId": "net.genral.generalhouse.test",
  "appName": "GNRL Operations TEST",
  "webDir": "www",
  "server": {
    "url": "https://generalsys.idigital-cs.com/login",
    "cleartext": false,
    "androidScheme": "https",
    "allowNavigation": [
      "generalsys.idigital-cs.com",
      "*.generalsys.idigital-cs.com"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#000000",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#79caf9",
      "overlaysWebView": false
    }
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#000000",
    "webContentsDebuggingEnabled": true
  }
}
