<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 15 (API 35) enables edge-to-edge by default for targetSdk 35+.
      We opt out of the enforcement so WindowCompat.setDecorFitsSystemWindows(true)
      in MainActivity can reserve status/nav bar space once (no CSS safe-area padding).
      Remove this when migrating to full inset-consumed edge-to-edge.
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@color/statusBar</item>
        <item name="android:navigationBarColor">@color/navigationBar</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
