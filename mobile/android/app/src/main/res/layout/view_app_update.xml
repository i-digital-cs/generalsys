<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ghUpdateOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F20D1117"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#121212"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/ghUpdateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Update available"
                android:textColor="#60D6FF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ghUpdateMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text=""
                android:textColor="#E6EDF3"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/ghUpdateNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#A8B3BF"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/ghUpdateLater"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:minHeight="48dp"
                    android:text="Later"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/ghUpdateNow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="Update Now" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
