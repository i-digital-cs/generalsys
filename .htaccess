<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep Let's Encrypt ACME challenges served from the web root
    RewriteRule ^\.well-known/ - [L]

    # Keep cgi-bin untouched
    RewriteRule ^cgi-bin/ - [L]

    # Route everything else through Laravel's public/ front controller
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Never list directory contents
Options -Indexes
